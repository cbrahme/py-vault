<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sync with Laptop"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Click 'Sync' on your laptop to show the QR code and PIN:"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnScanQr"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:text="📷 Scan QR Code on Laptop"
        android:textColor="@color/accent"
        app:strokeColor="@color/accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="— OR ENTER MANUALLY —"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etHost"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/search_bg"
        android:hint="Laptop IP:Port (e.g. 192.168.1.15:8765)"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_muted" />

    <EditText
        android:id="@+id/etPin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/search_bg"
        android:hint="6-Digit Sync PIN"
        android:inputType="number"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_muted" />

</LinearLayout>
